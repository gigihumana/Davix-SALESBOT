# ============================================
# DAVIX SALES BOT - Environment Configuration
# ============================================
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file or share it with anyone.

# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Discord Application (Client) ID - needed to auto-create application emojis
DISCORD_APPLICATION_ID=

# One or more Discord user IDs allowed to use owner-only commands, comma separated
BOT_OWNER_IDS=

# 32-byte urlsafe base64 key used to encrypt gateway credentials at rest.
# Generate one with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Optional: run a local webhook receiver for instant payment confirmations
# (Mercado Pago / Stripe / PayPal). If disabled, the bot falls back to
# polling each gateway's API instead.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
# Public base URL that the gateways can reach (e.g. behind a reverse proxy / tunnel)
WEBHOOK_PUBLIC_URL=https://your-domain.example.com

# How often (seconds) the bot polls pending orders for gateways without webhooks
PAYMENT_POLL_INTERVAL=15

# Database file path
DATABASE_PATH=data/davix_sales.db

# Timezone used in receipts/logs (IANA name)
TIMEZONE=America/Sao_Paulo
